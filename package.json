{
  "name": "game-html",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run copy && npm run copy2 && npm run rm:ico && npm run rm:scss && npm run start:project",
    "scss-old": "node-sass -watch -o dist/assets/css src/assets/scss",
    "scss": "sass --watch src/assets/scss:dist/assets/css",
    "copy": "node -e \"require('fs').cpSync('src/', 'dist/', {recursive: true});\"",
    "copy2": "node -e \"require('fs').copyFile('src/assets/images/favicon.ico', 'dist/favicon.ico', ()=>{});\"",
    "rm:ico": "node -e \"require('fs').rmSync('dist/assets/images/favicon.ico');\"",
    "rm:scss": "node -e \"require('fs').rmSync('dist/assets/scss', { recursive: true, force: true });\"",
    "start:project": "cd ./dist && http-server -c-1 -p 4200 --silent"
  },
  "private": true,
  "devDependencies": {
    "http-server": "^14.1.1",
    "sass": "^1.93.2",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.3"
  }
}
